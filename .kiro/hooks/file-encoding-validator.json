{
  "version": "v1",
  "hooks": [
    {
      "name": "Fix File Encoding (Remove UTF-8 BOM)",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "powershell.exe -NoProfile -File .kiro/scripts/fix-file-encoding.ps1 -FilePath \"{{filePath}}\""
      },
      "matcher": "\\.(java|properties|ya?ml|json|md|sql|gradle|xml)$",
      "enabled": true
    }
  ]
}
